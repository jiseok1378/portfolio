{
  "permissions": {
    "ask": ["Artifact"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-gemini-key.mjs\"",
            "timeout": 15,
            "statusMessage": "Gemini 키 확인 중"
          }
        ]
      }
    ]
  }
}
